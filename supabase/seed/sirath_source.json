   "entry_id": "hollows",
   "tier": "baseline",
   "dc": 14,
   "dc_is_placeholder": true,
   "teaser": null,
   "body": "A group of halflings lives in the Hollows almost like their own small settlement: gardens and artisan crafts, and they mostly look after themselves. Halflings are somewhat rare in Bleakspire.",
   "adds_aliases": [],
   "editorial_status": "canon",
   "canon_ref": "R-074"
  },
  {
   "skill": "history",
   "culture_id": null,
   "skill_tag_reason": null,
   "pull_quote": null,
   "id": "f-ho-3",
   "entry_id": "hollows",
   "tier": "roll",
   "dc": 14,
   "dc_is_placeholder": true,
   "teaser": "Why the empty houses stay empty.",
