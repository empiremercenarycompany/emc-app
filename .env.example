NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Set to 1 only on your own machine. The buttons stay hidden unless the host is localhost.
NEXT_PUBLIC_DEV_LOGIN=
# Local only. Never commit this and never set it in production.
# Dev login opens a test session with this key. It does not use a shared password.
# SUPABASE_SERVICE_ROLE_KEY=
# Staff sign-up mail through Gmail SMTP. If any of these is empty, mail is skipped.
EMC_NOTIFY_TO=
EMC_NOTIFY_SMTP_USER=
EMC_NOTIFY_SMTP_PASSWORD=
# Stripe test mode. Preview and Development only. Never Production.
# Hosted Checkout does not use the publishable key. Leave it for a later embedded form.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EMC_STRIPE_SECRET_KEY=
EMC_STRIPE_WEBHOOK_SECRET=
# Only the exact values true and 1 turn these on. Anything else is off.
BILLING_WANDERLUST_ENABLED=false
BILLING_SHIELDMATE_COUPON_ENABLED=false
